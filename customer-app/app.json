{
  "expo": {
    "name": "Sahara",
    "slug": "shara",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#4C1D95"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.quickhaul.customer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#4C1D95"
      },
      "package": "com.quickhaul.customer",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAyBnNXtmH2AHm-ctd8ZfegQvCzxmPRyO8"
        }
      }
    },
    "plugins": [
      "expo-location",
      "expo-image-picker",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#4C1D95"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f60581b5-dfe1-4ea4-a1c5-346071c5bd06"
      }
    },
    "owner": "sharaexpos-team"
  }
}
