{
  "name": "quickhaul-porter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix admin-panel",
    "backend":     "npm run dev --prefix backend",
    "admin":       "npm start --prefix admin-panel",
    "start":       "concurrently \"npm run backend\" \"npm run admin\"",
    "build:admin": "npm run build --prefix admin-panel"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
